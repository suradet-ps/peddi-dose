{
  "name": "pedi-dose",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Pediatric dose calculator for healthcare professionals (PWA)",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
"devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "fast-uri": "^4.0.0",
    "minimatch": "^10.2.5",
    "nanoid": "^6.0.0",
    "postcss": "^8.5.26"
  }
}
